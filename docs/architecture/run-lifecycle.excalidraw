    { "type": "rectangle", "version": 1, "id": "alerts-flow", "x": 80, "y": 430, "width": 880, "height": 130, "angle": 0, "strokeColor": "#9d174d", "backgroundColor": "#fce7f3", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": { "type": 3 }, "seed": 19 },
    { "type": "text", "version": 1, "id": "alerts-flow-text", "x": 100, "y": 445, "width": 840, "height": 110, "angle": 0, "strokeColor": "#831843", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 20, "fontSize": 15, "fontFamily": 1, "text": "alerts subscriber  (registered once at server start via instrumentation.ts)\n\n  on('runFinalized'  | 'runProgressed')  →  evaluateAndRecord(input)\n     1. fetch enabled rules for pipeline\n     2. evaluator.evaluate(rules, runInput)   ← JSONata cache\n     3. recorder.record(matches, run)         ← upsert AlertEvent (unique on ruleId+runId = idempotent)\n     4. if newly inserted → bus.publish('alertFired', { runId, ruleName, message })  ← SSE listens", "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "alerts subscriber  (registered once at server start via instrumentation.ts)\n\n  on('runFinalized'  | 'runProgressed')  →  evaluateAndRecord(input)\n     1. fetch enabled rules for pipeline\n     2. evaluator.evaluate(rules, runInput)   ← JSONata cache\n     3. recorder.record(matches, run)         ← upsert AlertEvent (unique on ruleId+runId = idempotent)\n     4. if newly inserted → bus.publish('alertFired', { runId, ruleName, message })  ← SSE listens", "lineHeight": 1.25, "baseline": 12 }
